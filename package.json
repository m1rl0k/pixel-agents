{
  "name": "pixel-agents",
  "description": "Standalone gamified orchestrator where AI agent workers collaborate on any task inside a pixel facility",
  "version": "1.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixel-agents-hq/pixel-agents"
  },
  "license": "MIT",
  "bin": {
    "pixel-agents": "./dist/cli.js"
  },
  "scripts": {
    "build:webview": "cd webview-ui && npm run build",
    "compile": "npm run asyncapi:generate && npm run check-types && npm run lint && node esbuild.js && npm run build:webview",
    "build": "npm run compile",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "asyncapi:generate": "tsx scripts/generate-messages.ts",
    "asyncapi:validate": "asyncapi validate core/asyncapi.yaml",
    "asyncapi:docs": "asyncapi start studio --file core/asyncapi.yaml",
    "check-types": "tsc --noEmit && tsc --noEmit -p server/tsconfig.test.json",
    "prepare": "husky",
    "lint": "eslint server core && cd webview-ui && eslint .",
    "lint:fix": "eslint server core --fix && cd webview-ui && eslint . --fix",
    "import-tileset": "tsx scripts/import-tileset-cli.ts",
    "format": "prettier --write \"server/**/*.ts\" \"core/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "format:check": "prettier --check \"server/**/*.ts\" \"core/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "test:webview": "cd webview-ui && npm test",
    "test:server": "cd server && npm test",
    "test": "npm run test:webview && npm run test:server",
    "facility": "PIXEL_AGENTS_FRESH_FACILITY=1 PIXEL_AGENTS_FAST_FACILITY=1 PIXEL_AGENTS_ORCHESTRATOR=1 node dist/cli.js --workers 20",
    "infra:redis": "docker compose -f docker-compose.redis.yml up -d redis",
    "infra:spacetime": "mkdir -p ~/.pixel-agents/spacetime && spacetime start --listen-addr 127.0.0.1:3000 --data-dir ~/.pixel-agents/spacetime",
    "infra:spacetime:publish": "spacetime publish pixel-agents-facility --module-path spacetime-facility/spacetimedb --server local -y --build-options='--lint-dir='",
    "knip": "knip"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.0.0",
    "@asyncapi/html-template": "^3.5.6",
    "@asyncapi/modelina": "^5.10.1",
    "@types/node": "25.x",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "lint-staged": "^16.3.2",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "server/**/*.ts": "eslint --fix",
    "core/src/**/*.ts": "eslint --fix",
    "webview-ui/src/**/*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,js,mjs,css,json,md}": "prettier --write",
    "webview-ui/**/*.{ts,tsx,js,css,json}": "prettier --write"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.1",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.8.5"
  }
}
