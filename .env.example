# Pixel Agents Environment Variables
# Copy this file to .env and uncomment variables as needed.
# .env is gitignored and loaded automatically by the F5 launch config.

# Enable verbose debug logging for hook events (SessionStart, SessionEnd, Stop, etc.)
PIXEL_AGENTS_DEBUG=1

# Real facility workers (at least one required unless PIXEL_AGENTS_DEMO=1)
# KIMI_CODING_API_KEY=
# KIMI_API_KEY=
# KIMI_CODING_API_BASE=https://api.kimi.com/coding/v1
# KIMI_CODING_MODEL=kimi-for-coding
# ZAI_GLM_5_1_CODING_API_KEY=
# ZAI_GLM_5_1_CODING_API_BASE=https://api.z.ai/api/coding/paas/v4
# ZAI_GLM_5_CODING_API_KEY=
# ZAI_GLM_5_CODING_API_BASE=https://api.z.ai/api/coding/paas/v4
# PIXEL_AGENTS_CLAUDE_WORKERS=1
# PIXEL_AGENTS_CURSOR_WORKERS=1
# PIXEL_AGENTS_DEMO=1
