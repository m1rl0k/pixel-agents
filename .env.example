# Pixel Agents Environment Variables
# Copy this file to .env and uncomment variables as needed.
# .env is gitignored and loaded automatically by the F5 launch config.

# Enable verbose debug logging for hook events (SessionStart, SessionEnd, Stop, etc.)
PIXEL_AGENTS_DEBUG=1

# Real facility workers (at least one required)
# PIXEL_AGENTS_WORKERS=20
# KIMI_CODING_API_KEY=
# KIMI_API_KEY=
# KIMI_CODING_API_BASE=https://api.kimi.com/coding/v1
# KIMI_CODING_MODEL=kimi-for-coding
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro
# NVIDIA_NIM_MINIMAX_MODEL=minimaxai/minimax-m2.7
# NVIDIA_NIM_KIMI_MODEL=moonshotai/kimi-k2.6
# NVIDIA_NIM_GLM_MODEL=z-ai/glm-5.1
# ZAI_GLM_5_1_CODING_API_KEY=
# ZAI_GLM_5_1_CODING_API_BASE=https://api.z.ai/api/coding/paas/v4
# ZAI_GLM_5_CODING_API_KEY=
# ZAI_GLM_5_CODING_API_BASE=https://api.z.ai/api/coding/paas/v4
# Redis/Lua mission context store. Start with:
# docker compose -f docker-compose.redis.yml up -d redis
# PIXEL_AGENTS_REDIS=1
# PIXEL_AGENTS_REDIS_URL=redis://127.0.0.1:6379
# PIXEL_AGENTS_REDIS_PREFIX=pixel-agents
# SpacetimeDB reducer mirror:
# SPACETIMEDB_DATABASE=pixel-agents-facility
# SPACETIMEDB_SERVER=local
# PIXEL_AGENTS_CLAUDE_WORKERS=1
# PIXEL_AGENTS_CURSOR_WORKERS=1
